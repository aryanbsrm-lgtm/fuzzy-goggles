{
  "name": "cross-platform-consensus-bridge",
  "version": "1.0.0",
  "description": "Multi-group consensus verification and cross-platform forwarder engine",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "esbuild src/*.ts src/**/*.ts --outdir=dist --format=esm --platform=node && mkdir -p dist/data dist/public/img && cp src/data/markets.json dist/data/markets.json && cp -r public/* dist/public/",
    "typecheck": "tsc --noEmit",
    "start": "node dist/scripts/startLocalPreview.js",
    "start:build": "npm run build && node dist/scripts/startLocalPreview.js",
    "dev": "tsx watch src/index.ts",
    "preview": "npm run build && node dist/scripts/startLocalPreview.js",
    "discover-groups": "npm run build && node dist/scripts/discoverGroups.js",
    "add-channel": "npm run build && node dist/scripts/resolveChannel.js",
    "add-sources": "npm run build && node dist/scripts/addSources.js",
    "get-chat-id": "npm run build && node dist/scripts/getTelegramChatId.js",
    "pm2:start": "npm run build && pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop consensus-bridge",
    "pm2:logs": "pm2 logs consensus-bridge",
    "pm2:restart": "npm run build && pm2 restart consensus-bridge",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "whatsapp",
    "telegram",
    "baileys",
    "grammy",
    "consensus",
    "bridge",
    "bot"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.13",
    "dotenv": "^16.4.7",
    "grammy": "^1.34.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode-terminal": "^0.12.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
