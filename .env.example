# ==========================================
# RESULT BOT - ENVIRONMENT CONFIGURATION
# ==========================================

# Telegram Bot Token (obtain from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Destination Channel Chat ID (e.g. -1001234567890)
TELEGRAM_CHAT_ID=-1001234567890

# Telegram Administrator User IDs (comma-separated, e.g. 12345678,87654321)
# Admins can approve/reject new groups, execute /scrape, view /pending requests, and manage destinations
TELEGRAM_ADMIN_IDS=12345678

# Direct DPBoss.boston Web Scraper & Verification Cycle
DPBOSS_ENABLED=true
DPBOSS_URL=https://dpboss.boston
DPBOSS_POLL_INTERVAL_SEC=30
DPBOSS_AUTO_VERIFY=true
DPBOSS_OWNER_ID=owner_dpboss

# Optional WhatsApp Multi-Device Session Storage Directory (defaults to ./auth_info_baileys)
WHATSAPP_AUTH_DIR=./auth_info_baileys

# Optional Phone Number with country code if using pairing code instead of QR (e.g. 15551234567)
# Leave blank to use standard Terminal QR scan
WHATSAPP_PHONE_NUMBER=

# Google Sheet verification source
GOOGLE_SHEET_ENABLED=true
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/your_spreadsheet_id/edit
GOOGLE_SHEET_TAB_NAME=Sheet1
GOOGLE_SHEET_POLL_INTERVAL_SEC=30
GOOGLE_SHEET_SCRAPER_CYCLE_SEC=300
GOOGLE_SHEET_SCRAPER_CYCLE_OFFSET_SEC=88
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service_account.json
GOOGLE_SHEET_OWNER_ID=owner_web_scraper

# On-Demand Website Scraper Integration
SCRAPER_ENABLED=true
SCRAPER_TRIGGER_MODE=auto
SCRAPER_CLI_COMMAND=/opt/scraper-hub/.venv/bin/python -c "import app; app.run_job(2)"
SCRAPER_WORKING_DIR=/opt/scraper-hub
SCRAPER_HTTP_URL=http://127.0.0.1:8094/api/job/2/run
SCRAPER_DEBOUNCE_SEC=10
SCRAPER_AUTO_TRIGGER=true

# Log Level (trace, debug, info, warn, error)
LOG_LEVEL=info

# ==========================================
# VERIFIED GAME RESULT API & HASH KEYS
# ==========================================
RESULT_API_ENABLED=true
RESULT_API_HASH_KEY=result_bot_secret_2026
RESULT_API_ALLOWED_KEYS=result_bot_secret_2026,partner_key_alpha,partner_key_beta

